<?xml version="1.0" encoding="utf-8"?>
<!--
  Same adaptive icon for the round variant. Launchers that ask for roundIcon
  get the identical source and apply their own circular mask — supplying a
  separately-drawn round icon would only be a second thing to keep in step.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
