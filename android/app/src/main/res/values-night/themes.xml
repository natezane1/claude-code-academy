<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately identical to values/themes.xml.

      This file exists so that a phone in dark mode resolves to exactly the same
      theme rather than falling through to a platform default. The course has no
      light variant, so there is nothing to swap.
    -->
    <style name="Theme.Academy" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
