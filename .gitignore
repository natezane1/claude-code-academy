# Build outputs — all regenerated by the build scripts, so they are not tracked.
#   bash build-app.sh              -> claude-code-academy.html
#   bash make-icon.sh              -> icon.png, icon.ico
#   bash win/build-exe.sh          -> win/*.exe, win/payload.html, win/icon.ico, win/*.o
#   bash linux/build-linux-app.sh  -> linux/claude-code-academy, linux/icon.png
claude-code-academy.html
icon.png
icon.ico

win/payload.html
win/icon.ico
win/*.o
win/*.exe

linux/claude-code-academy
linux/icon.png
